{
    "name": "upgrade-lab/laravel-pricing",
    "description": "An original Laravel pricing migration fixture",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0",
        "upgrade-lab/credit-ledger": "^1.0",
        "upgrade-lab/price-catalog": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "PricingLab\\": "app/"
        }
    },
    "repositories": [
        {
            "type": "package",
            "package": [
                {"name": "upgrade-lab/credit-ledger", "version": "1.0.0", "type": "metapackage", "require": {"laravel/framework": "^12.0"}},
                {"name": "upgrade-lab/credit-ledger", "version": "2.0.0", "type": "metapackage", "require": {"laravel/framework": "^13.0"}},
                {"name": "upgrade-lab/price-catalog", "version": "1.0.0", "type": "metapackage", "require": {"laravel/framework": "^12.0"}},
                {"name": "upgrade-lab/price-catalog", "version": "2.0.0", "type": "metapackage", "require": {"laravel/framework": "^13.0"}}
            ]
        }
    ],
    "config": {
        "allow-plugins": false,
        "platform": {"php": "8.4.28"},
        "sort-packages": true
    }
}
